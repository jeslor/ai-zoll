{
  "name": "ai-zoll",
  "version": "0.0.0",
  "private": true,
  "description": "AI Zoll monorepo — prepares projects for AI-assisted development.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
