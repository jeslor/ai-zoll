{
  "name": "ai-zoll",
  "version": "0.0.0",
  "private": true,
  "description": "CLI for AI Zoll (npx ai-zoll ...).",
  "bin": {
    "ai-zoll": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "echo \"[cli] lint tooling pending (Phase 0)\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-zoll/agents": "workspace:^",
    "@ai-zoll/ai": "workspace:^",
    "@ai-zoll/blueprint": "workspace:^",
    "@ai-zoll/generators": "workspace:^",
    "@ai-zoll/shared": "workspace:^",
    "@inquirer/prompts": "^8.5.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
